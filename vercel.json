{
  "headers": [
    {
      "source": "/models/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/js/(.*)\\.min\\.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/js/chunks/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/css/(.*)\\.min\\.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/hero-mobile/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/js/draco/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/nl",
      "destination": "/nl.html"
    },
    {
      "source": "/afspraak",
      "destination": "/afspraak.html"
    }
  ],
  "redirects": [
    {
      "source": "/nl.html",
      "destination": "/nl",
      "permanent": true
    },
    {
      "source": "/afspraak.html",
      "destination": "/afspraak",
      "permanent": true
    },
    {
      "source": "/a-propos.html",
      "destination": "/#a-propos",
      "permanent": true
    },
    {
      "source": "/services.html",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/zone.html",
      "destination": "/#zone",
      "permanent": true
    },
    {
      "source": "/fonctionnement.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/contact.html",
      "destination": "/reserver.html",
      "permanent": true
    },
    {
      "source": "/devis.html",
      "destination": "/reserver.html",
      "permanent": true
    },
    {
      "source": "/demande.html",
      "destination": "/reserver.html",
      "permanent": true
    },
    {
      "source": "/forms.html",
      "destination": "/reserver.html",
      "permanent": true
    }
  ]
}
